---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
const { title, description, lang, page = 'home' } = Astro.props as { title: string; description: string; lang: Lang; page?: string };
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, site);
const enURL = new URL(Astro.url.pathname.replace(/\/(en|zh)(\/|$)/, '/en$2'), site);
const zhURL = new URL(Astro.url.pathname.replace(/\/(en|zh)(\/|$)/, '/zh$2'), site);
const icon = new URL(`${base}brand/applane.png`, site);
const schema = page === 'home' ? { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AppLane', applicationCategory: 'UtilitiesApplication', operatingSystem: 'macOS 14 or later', description, url: canonical.href } : null;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical.href} />
  <link rel="alternate" hreflang="en" href={enURL.href} />
  <link rel="alternate" hreflang="zh-Hans" href={zhURL.href} />
  <link rel="alternate" hreflang="x-default" href={enURL.href} />
  <link rel="icon" href={`${base}brand/favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" href={`${base}brand/icon-32.png`} sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />
  <meta name="theme-color" content="#080b11" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="AppLane" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical.href} />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} /><meta property="og:image" content={icon.href} />
  <meta name="twitter:card" content="summary" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={icon.href} />
  <title>{title}</title>
  {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>}
</head>
<body>
  <a class="skip-link" href="#content">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
  <Header lang={lang} /><main id="content"><slot /></main><Footer lang={lang} />
</body>
</html>
