---
import AppIcon from './AppIcon.astro';
import { getText, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = getText(lang);
const base = import.meta.env.BASE_URL;
const screenshot = `${base}screenshots/${lang === 'zh' ? 'zh' : 'en'}/hero.webp`;
---
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{t('hero.eyebrow')}</p><AppIcon class="hero-icon" /><h1>{t('hero.title')}</h1>
    <p class="hero-description">{t('hero.description')}</p>
    <div class="hero-actions"><a class="button primary" href="#routing">{t('hero.primary')}</a><a class="button secondary" href={localePath(lang, 'privacy/')}>{t('hero.secondary')}</a></div>
    <div class="release-note"><span>{t('hero.status')}</span><p>{t('hero.statusNote')}</p></div>
  </div>
  <figure class="preview-frame">
    <img class="hero-screenshot" src={screenshot} alt={t('hero.previewTitle')} width="1600" height="1067" fetchpriority="high" decoding="async" />
    <figcaption><strong>{t('hero.previewTitle')}</strong><span>{t('hero.previewCopy')}</span></figcaption>
  </figure>
</section>
