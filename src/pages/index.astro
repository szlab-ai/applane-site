---
const base = import.meta.env.BASE_URL; const english = `${base}en/`; const chinese = `${base}zh/`; const canonical = new URL(english, Astro.site ?? Astro.url.origin);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><meta http-equiv="refresh" content={`0; url=${english}`}/><link rel="canonical" href={canonical.href}/><title>AppLane</title><script is:inline set:html={`const target=(navigator.language||'').toLowerCase().startsWith('zh')?${JSON.stringify(chinese)}:${JSON.stringify(english)};location.replace(target);`}></script></head><body><p><a href={english}>English</a> · <a href={chinese}>简体中文</a></p></body></html>
